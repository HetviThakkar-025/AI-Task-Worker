# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here
# Primary model, then comma-separated fallbacks used when quota runs out / model is unavailable
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview

# Comma-separated paths (relative to the base URL) the agent is told to start from
START_PATHS=/portal,/finance

# WSL/Linux only: folder with extra shared libraries for Chromium (see README). Leave empty if not needed.
PW_LIB_PATH=

# Clicking Save/Submit/Create with an "amount" field at or above this value requires human approval
APPROVAL_THRESHOLD=100000

# 1 = headless browser (default), 0 = visible window (same as --headed)
HEADLESS=1
# Delay in ms added to every browser action (useful for demo recordings), 0 = off
SLOW_MO_MS=0
